{
  "schema_version": 1,
  "diagram_type": "architecture",
  "meta": {
    "title": "react-resource-view",
    "locale": "en",
    "output": "../website/public/architecture.html",
    "quality_profile": "showcase",
    "views": [
      {
        "id": "declare",
        "label": "Declaring a resource",
        "focus": ["host-app", "ports", "registry", "provider"],
        "note": "The application declares its resources and wires its router in, once at startup."
      },
      {
        "id": "resolve",
        "label": "Resolving the URL",
        "focus": ["routes", "registry", "context", "scope"],
        "note": "A URL carries the scope, the resource, the action and the filters; the context reads them back."
      },
      {
        "id": "render",
        "label": "Rendering the view",
        "focus": ["context", "views", "variants", "forms"],
        "note": "One context feeds the view of the current action, and the layout the reader picked."
      },
      {
        "id": "fetch",
        "label": "Reaching the API",
        "focus": ["context", "repository", "api"],
        "note": "Every resource carries its own repository, so the views never talk to the API themselves."
      }
    ]
  },
  "layout": {
    "mode": "grid",
